#!/bin/sh
# library-install — deploys the Library from origin/main (library issue
# issue_01M3YHZHGXJ49HE5C6EEPK93M3). Replaces the hand sequence of
# fast-forwarding the checkout, running bin/install-library, and checking
# --status and /health yourself — twice (2026-09-06, 2026-10-01) the
# fast-forward step alone was skipped and stale code got deployed.
#
# **ITS ONE AUTOMATED CALLER IS bin/library-deploy-watch, operator-authorized
# (CQ·94, issue comment 5111, 2026-10-09: "every merge should autodeploy").**
# That launchd job runs this file, unmodified, whenever the checkout's
# origin/main is ahead of what it last installed. No other automated caller
# is authorized, and the rule below is otherwise unchanged: no agent and no
# test may execute this script's deploy path by hand, on this machine,
# under any HOME.
#
# **No agent and no test may execute this script's deploy path.** On
# 2026-10-02 a coder hand-ran bin/install-library directly under a fake HOME
# and unloaded the live Library service, because a fake HOME does not
# isolate launchd from the real gui domain, the real launchctl binary, or
# the real service label. This script's own step (d) below runs that same
# installer, so the identical hazard applies to it, undiminished. The only
# two things a test may do with this file are: (1) source it with
# LIBRARY_INSTALL_SOURCE_ONLY set, to call its functions directly, never
# reaching main(); and (2) run it end to end against a throwaway git
# repository (never this checkout) with LIBRARY_INSTALL_TEST_INSTALL_LIBRARY
# pointed at a stub install-library the test itself created, outside that
# repository's own tree entirely. main() below refuses outright when that
# variable, once every symlink in it is resolved, names either the real
# install-library next to this file or anything inside this checkout — not
# just an exact string match, so a symlink, a relative path, a `./`, `//` or
# `..` spelling, or a copy placed inside the repo all refuse the same as the
# exact path would. main() separately refuses LIBRARY_INSTALL_TEST_HEALTH_URL
# whenever it is set without that same install-library redirect also in
# place, since faking only the health check would let a real run misreport
# its own verdict. See the checks at the top of main().
#
# WHAT THIS DOES, in order, against the checkout this file itself lives in
# (found by resolving every symlink in $0 back to where this file actually
# resides — the documented install is a symlink at ~/.local/bin/library-
# install, and $0 there is the symlink's own path, never the checkout's):
#   (a) Fetches origin, then fast-forwards local main (`git merge --ff-only`).
#       Refuses, changing nothing, on a dirty tree, a branch other than main
#       checked out, or a main that cannot fast-forward to origin/main. Never
#       checks a different branch out for the operator. A fetch failure also
#       names refs/stash and its removal command when that ref exists (the
#       2026-10-08 incident, below), the same hint install-library's own
#       fetches already print.
#   (b) Refuses unless local main (refs/heads/main) now equals origin/main
#       (refs/remotes/origin/main) exactly, read by those fully-qualified
#       refs — never a bare "main", which a stray tag of that name would let
#       resolve to the tag's commit instead of the branch's.
#   (c) Reads ~/.local/deploy/library/DEPLOYED_COMMIT. Refuses, naming the
#       problem, when the file exists but isn't readable, has no commit
#       line, or names a commit this checkout doesn't have or that isn't an
#       ancestor of the target; refuses pointing at a manual first install
#       when the file doesn't exist at all, since library-install manages a
#       repeat deploy against a recorded baseline, not a first one. Otherwise
#       prints the deployed commit, the target commit, and the merged PR
#       titles between them (the first-parent commit subjects of the range,
#       with control bytes stripped so a crafted commit subject can't write
#       a terminal escape sequence). Reports, rather than refusing, when the
#       range touches alembic/versions: bin/install-library's own auto-
#       migrate path (step (d) below) backs up the vault and applies the
#       pending revision, so this script hands it the range instead of
#       stopping here. Separately warns (does not refuse) when the range
#       adds or changes a launchd/ job other than com.convivy.library.plist,
#       since install-library manages only that one plist.
#   (d) Runs this (now fast-forwarded) checkout's own bin/install-library,
#       passing --no-migrate through when this script was itself given that
#       flag. Refuses exactly when install-library does — an unknown vault
#       revision, a `LIBRARY_AUTO_APPLY = False` revision (see alembic/
#       README), a failed migration, or --no-migrate over a vault that is
#       behind — surfacing its message and exiting non-zero without step (e)
#       below.
#   (e) Polls `/health` (the commit/staged_commit it reports) against the
#       target commit until they agree or a deadline passes, then prints a
#       one-line verdict comparing that against the commit `install-library
#       --status` reports. The deadline is app.py's own
#       `_DRAIN_DEADLINE_SECONDS` (the just-deployed release's, read fresh
#       from the deploy area) plus a startup allowance, because the running
#       process self-restarts onto the new commit rather than being
#       reloaded by this script, and a single immediate read of `/health`
#       cannot have observed that restart yet (library issue
#       issue_01M584Q5SH8BQVGABSQWBPBV62: a deploy that left the service
#       down reported "Deploy confirmed" exactly because of that gap,
#       exiting 0 regardless). On agreement, prints "Deploy confirmed" and
#       returns 0, same as before. On a timeout, prints the last `/health`
#       answer, says the code is installed but the service is not serving
#       it, and exits 3 — distinct from every refusal above and from
#       install-library's own, so a log tells the two apart. `exit 3` is
#       itself enough to make library-deploy-watch post a `deploy_failure`
#       signal for the target; it does not retry anything itself.
#
# Takes one optional argument, --no-migrate, passed through to
# bin/install-library unchanged (same meaning: never apply a pending
# migration, refuse instead whenever the vault is behind). Run it from this
# repo's own checkout, on main.
set -eu

# Resolves $1 to an absolute, symlink-free path: follows a readlink chain
# (relative or absolute link targets, any number of hops — no `readlink -f`,
# since macOS's readlink has none) until it names something that is not
# itself a symlink, then canonicalizes the containing directory with
# `cd ... && pwd -P`, which also resolves a symlinked ancestor directory.
# Needed because $0 under the documented install (a symlink at
# ~/.local/bin/library-install) is the symlink's own path, and a plain
# `dirname "$0"` pointed every downstream use of $REPO at the symlink's
# directory instead of this checkout's.
_resolve_symlinks() {
  target="$1"
  while [ -L "$target" ]; do
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  dir="$(cd "$(dirname "$target")" && pwd -P)"
  printf '%s/%s\n' "$dir" "$(basename "$target")"
}

# $0 as the shell actually found it: unchanged when it already names a
# directory, or resolved through $PATH when invoked by a bare command name
# (some shells leave $0 bare in that case, with no symlink target to chase
# until it is).
case "$0" in
  */*) SELF="$0" ;;
  *) SELF="$(command -v "$0")" ;;
esac
SELF="$(_resolve_symlinks "$SELF")"
REPO="$(cd "$(dirname "$SELF")/.." && pwd -P)"
DEPLOY_DIR="${HOME}/.local/deploy/library"
DEPLOYED_COMMIT_FILE="$DEPLOY_DIR/DEPLOYED_COMMIT"
PLIST_TEMPLATE="$REPO/launchd/com.convivy.library.plist"
LIVE_PLIST="${HOME}/Library/LaunchAgents/com.convivy.library.plist"
REAL_INSTALL_LIBRARY="$REPO/bin/install-library"
REAL_INSTALL_LIBRARY_RESOLVED="$(_resolve_symlinks "$REAL_INSTALL_LIBRARY")"
# LIBRARY_INSTALL_TEST_INSTALL_LIBRARY is a test-only seam, never set in a
# human run: redirects step (d) at a stub install-library instead of this
# checkout's real one. main() refuses outright when it resolves to the real
# $REAL_INSTALL_LIBRARY or to anywhere inside $REPO — see
# _refuse_unsafe_install_library_redirect — which is what keeps this seam
# from ever reaching the real installer from under a test.
INSTALL_LIBRARY_BIN="${LIBRARY_INSTALL_TEST_INSTALL_LIBRARY:-$REAL_INSTALL_LIBRARY}"

say() { printf '\033[1;34m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
_refuse() { echo "library-install: $*" >&2; exit 1; }

# Parses plist file $1's own EnvironmentVariables for key $2, printing its
# value and returning 0 — or returning 1 with nothing printed when $1 does
# not exist or does not set that key. Deliberately a separate copy of
# install-library's own `_plist_env_pairs`, not a shared one: the two scripts
# are independent on purpose (ADR-0059's installer is not a library this
# script imports), so a future change to one cannot silently change what the
# other parses.
_plist_env_value() {
  [ -f "$1" ] || return 1
  awk -v key="$2" '
    /<key>EnvironmentVariables<\/key>/ { in_env=1; next }
    in_env && /<\/dict>/ { in_env=0 }
    in_env && /<key>/ {
      k=$0; sub(/.*<key>/,"",k); sub(/<\/key>.*/,"",k); pending=k; next
    }
    in_env && pending != "" && /<string>/ {
      v=$0; sub(/.*<string>/,"",v); sub(/<\/string>.*/,"",v)
      if (pending == key) { print v; found=1 }
      pending=""
    }
    END { exit (found ? 0 : 1) }
  ' "$1"
}

# The port the running service listens on: LIVE_PLIST's own LIBRARY_PORT if
# install-library has ever written one there, else PLIST_TEMPLATE's, else
# 8100. No plist in this repo has ever set LIBRARY_PORT, so today this always
# falls through to 8100.
_service_port() {
  for candidate in "$LIVE_PLIST" "$PLIST_TEMPLATE"; do
    PORT="$(_plist_env_value "$candidate" LIBRARY_PORT 2>/dev/null)" && [ -n "$PORT" ] && {
      printf '%s\n' "$PORT"
      return 0
    }
  done
  printf '%s\n' 8100
}

# The health URL to poll in step (e). LIBRARY_INSTALL_TEST_HEALTH_URL is a
# test-only override of it — main() refuses outright whenever this variable
# is set without LIBRARY_INSTALL_TEST_INSTALL_LIBRARY also redirecting step
# (d), so by the time this function is ever called in a real run, the
# override is either absent or paired with a deploy that is itself already
# redirected to a stub, never the live service.
_health_url() {
  if [ -n "${LIBRARY_INSTALL_TEST_HEALTH_URL:-}" ]; then
    printf '%s\n' "$LIBRARY_INSTALL_TEST_HEALTH_URL"
    return 0
  fi
  printf 'http://127.0.0.1:%s/health\n' "$(_service_port)"
}

_fetch_health() {
  curl -s --max-time 5 "$(_health_url)" 2>/dev/null || true
}

# Extracts "$2":"value" out of the one-line JSON body $1 — /health's own
# body is flat JSON with no escaped quotes in either field, both plain hex
# commit shas, so this plain sed is exact for it without a JSON parser.
_health_field() {
  printf '%s' "$1" | sed -n 's/.*"'"$2"'":"\([^"]*\)".*/\1/p' | head -n 1
}

# How often step (e) re-polls /health once the first attempt disagrees.
# Fixed, not test-overridable: the only input a test needs to vary is how
# LONG the deadline below runs, not how often this asks within it.
_HEALTH_POLL_INTERVAL_S=1

# Added on top of app.py's own _DRAIN_DEADLINE_SECONDS (below) for however
# long the new process itself takes to come up once the old one has
# drained and exited. Generous against the two seconds every observed
# self-restart has actually taken (library issue
# issue_01M584Q5SH8BQVGABSQWBPBV62).
_HEALTH_POLL_STARTUP_ALLOWANCE_S=10

# Used in place of the sum above only when $DEPLOY_DIR/app.py's own
# _DRAIN_DEADLINE_SECONDS cannot be read at all (see _drain_deadline_seconds)
# — large enough to cover a genuinely slow restart without guessing at the
# real bound, small enough to stay well inside library-deploy-watch's
# INSTALL_TIMEOUT_S of 600s.
_HEALTH_POLL_DEADLINE_FALLBACK_S=120

# A deliberate copy of bin/install-library's own _drain_deadline_seconds,
# not a shared one — same reasoning as _plist_env_value above: the two
# scripts are independent on purpose. Reads $1 (the release step (d) just
# staged, so its app.py) for a top-level _DRAIN_DEADLINE_SECONDS, truncated
# to whole seconds. Prints nothing — never zero — when the line isn't
# there or isn't a plain integer once parsed, which the caller below treats
# as "could not read." Always returns 0, even when $1 doesn't exist at
# all: awk itself exits nonzero on a missing file, and the one caller
# below assigns this straight into a variable (`drain="$(...)"`), which
# under this script's own `set -eu` would abort the whole deploy on that
# nonzero status — exactly the case this function's fallback exists to
# survive, not trigger.
_drain_deadline_seconds() {
  awk '
    /^_DRAIN_DEADLINE_SECONDS[ \t]*(:[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*)?=/ {
      line = $0
      sub(/^[^=]*=/, "", line)
      sub(/#.*/, "", line)
      gsub(/[ \t]/, "", line)
      sub(/\.[0-9]*$/, "", line)
      if (line ~ /^[0-9]+$/) print line
      exit
    }
  ' "$1" 2>/dev/null || true
}

# The total number of seconds step (e) polls /health for before giving up:
# app.py's own _DRAIN_DEADLINE_SECONDS (read fresh from $DEPLOY_DIR/app.py)
# plus _HEALTH_POLL_STARTUP_ALLOWANCE_S, or _HEALTH_POLL_DEADLINE_FALLBACK_S
# when that constant cannot be read.
_health_poll_deadline_seconds() {
  drain="$(_drain_deadline_seconds "$DEPLOY_DIR/app.py")"
  case "$drain" in
    ''|*[!0-9]*) printf '%s\n' "$_HEALTH_POLL_DEADLINE_FALLBACK_S" ;;
    *) printf '%s\n' "$((drain + _HEALTH_POLL_STARTUP_ALLOWANCE_S))" ;;
  esac
}

# The "commit: <sha>" line out of a DEPLOYED_COMMIT file ($1), or nothing
# (not an error) when $1 doesn't exist yet — the state before any install.
_deployed_sha() {
  [ -f "$1" ] || return 0
  sed -n 's/^commit: //p' "$1" | head -n 1
}

# Resolves the previously-deployed commit recorded in $1 against target
# commit $2 in $REPO. Prints that deployed sha and returns 0 on success.
# Returns 2 with nothing printed and nothing written to stderr when $1 does
# not exist at all — nothing has ever been deployed, and it is the caller's
# call what that means. Otherwise, on any problem (unreadable, no commit
# line, a commit this checkout doesn't have, or a commit that isn't an
# ancestor of $2), prints a refusal naming the problem to stderr and returns
# 1 — collapsing any of these into "nothing deployed" would skip the alembic
# refusal below on a live service whose baseline merely went missing.
_resolve_deployed_sha() {
  baseline_file="$1"
  target_sha="$2"
  [ -f "$baseline_file" ] || return 2
  if [ ! -r "$baseline_file" ]; then
    echo "library-install: $baseline_file exists but is not readable — refusing." >&2
    return 1
  fi
  sha="$(_deployed_sha "$baseline_file")"
  if [ -z "$sha" ]; then
    echo "library-install: $baseline_file exists but has no 'commit: <sha>' line — refusing." >&2
    return 1
  fi
  if ! git -C "$REPO" cat-file -e "${sha}^{commit}" 2>/dev/null; then
    echo "library-install: $baseline_file names commit $sha, which $REPO does not have — refusing." >&2
    return 1
  fi
  if ! git -C "$REPO" merge-base --is-ancestor "$sha" "$target_sha" 2>/dev/null; then
    echo "library-install: $baseline_file names commit $sha, which is not an ancestor of target $target_sha — refusing." >&2
    return 1
  fi
  printf '%s\n' "$sha"
}

# Strips C0 control bytes (0x00-0x1F) other than tab and newline, and DEL
# (0x7F), from stdin. Applied to anything that came from a commit (a subject
# line, a file name) before it reaches the operator's terminal, so a
# commit that already passed this repo's own review can't smuggle a
# terminal escape sequence (title spoofing, an OSC 52 clipboard write) into
# what this script prints.
_strip_controls() {
  tr -d '\000-\010\013-\037\177'
}

# Refuses when $1 — the LIBRARY_INSTALL_TEST_INSTALL_LIBRARY redirect — once
# every symlink in it is resolved, is the exact file $REAL_INSTALL_LIBRARY
# resolves to, or lies anywhere inside $REPO. An exact string match on $1 is
# not enough: a symlink, a relative path, a `./`, `//` or `..` spelling, or a
# copy placed inside this checkout all compare unequal to
# $REAL_INSTALL_LIBRARY while still reaching it, or something this repo
# owns, once resolved. `test -ef` is an extra, redundant check on top of the
# path comparison above, not a replacement for it — it is not POSIX and some
# shells' `test` simply report it false, which the path comparison already
# covers correctly either way.

# Prints, when $REPO's fetch of origin just failed, one more line naming
# refs/stash and the command to remove it — a stash pushed in ANY linked
# worktree of this repo lands at this one shared ref (library issue: on
# 2026-10-08 a dispatched run's `git stash` in a linked worktree left
# refs/stash pointing at a commit whose objects were never completed, and
# every fetch in every worktree of that repo then failed with "fatal: bad
# object refs/stash"). Never removes it — that is the operator's call, not
# this script's. A deliberate copy of install-library's own function of the
# same name, not a shared import: the two scripts are independent on
# purpose (see the comment on `_plist_env_value` above), so a future change
# to one cannot silently change what the other does on this path either.
_stash_hint_on_fetch_failure() {
  if git -C "$REPO" show-ref --verify --quiet refs/stash; then
    echo "  refs/stash exists in $REPO and may be why — it is shared by every worktree of this repo, so a stash pushed in any of them lands here. Remove it with:" >&2
    echo "    git -C $REPO update-ref -d refs/stash" >&2
  fi
}

_refuse_unsafe_install_library_redirect() {
  redirect="$1"
  [ -e "$redirect" ] || _refuse "LIBRARY_INSTALL_TEST_INSTALL_LIBRARY ($redirect) does not exist."
  redirect_resolved="$(_resolve_symlinks "$redirect")"
  if [ "$redirect_resolved" = "$REAL_INSTALL_LIBRARY_RESOLVED" ]; then
    _refuse "LIBRARY_INSTALL_TEST_INSTALL_LIBRARY resolves to the real $REAL_INSTALL_LIBRARY (same file) — it must redirect to a stub outside this repository."
  fi
  case "$redirect_resolved" in
    "$REPO"/*)
      _refuse "LIBRARY_INSTALL_TEST_INSTALL_LIBRARY resolves to $redirect_resolved, inside this repository ($REPO) — it must redirect to a stub outside this repository." ;;
  esac
  if [ -e "$REAL_INSTALL_LIBRARY" ] && [ "$redirect" -ef "$REAL_INSTALL_LIBRARY" ] 2>/dev/null; then
    _refuse "LIBRARY_INSTALL_TEST_INSTALL_LIBRARY is the same file as $REAL_INSTALL_LIBRARY (test -ef) — it must redirect to a stub outside this repository."
  fi
}

main() {
  NO_MIGRATE=0
  for arg in "$@"; do
    case "$arg" in
      --no-migrate) NO_MIGRATE=1 ;;
      *) _refuse "unknown option: $arg (the only argument this script takes is --no-migrate)." ;;
    esac
  done

  if [ -n "${LIBRARY_INSTALL_TEST_INSTALL_LIBRARY:-}" ]; then
    _refuse_unsafe_install_library_redirect "$LIBRARY_INSTALL_TEST_INSTALL_LIBRARY"
  fi
  if [ -n "${LIBRARY_INSTALL_TEST_HEALTH_URL:-}" ] && [ -z "${LIBRARY_INSTALL_TEST_INSTALL_LIBRARY:-}" ]; then
    _refuse "LIBRARY_INSTALL_TEST_HEALTH_URL is set but LIBRARY_INSTALL_TEST_INSTALL_LIBRARY is not — refusing, since faking the verdict's health check without also redirecting the installer it is meant to confirm would let a real deploy report false confidence."
  fi

  # --- (a) fetch and fast-forward -----------------------------------------
  if [ -n "$(git -C "$REPO" status --porcelain)" ]; then
    _refuse "$REPO has uncommitted changes — commit, stash, or discard them, then re-run."
  fi
  # git symbolic-ref reads HEAD's own symbolic content, with no name lookup
  # against branches/tags/etc — unlike `rev-parse --abbrev-ref HEAD`, a tag
  # named "main" cannot make this one say anything but refs/heads/main.
  CURRENT_REF="$(git -C "$REPO" symbolic-ref -q HEAD)" || CURRENT_REF=""
  if [ "$CURRENT_REF" != "refs/heads/main" ]; then
    case "$CURRENT_REF" in
      refs/heads/*) BRANCH_DISPLAY="${CURRENT_REF#refs/heads/}" ;;
      "") BRANCH_DISPLAY="(detached HEAD)" ;;
      *) BRANCH_DISPLAY="$CURRENT_REF" ;;
    esac
    _refuse "$REPO has '$BRANCH_DISPLAY' checked out, not main — checkout main yourself, then re-run."
  fi
  git -C "$REPO" fetch --quiet origin || {
    echo "library-install: could not fetch origin." >&2
    _stash_hint_on_fetch_failure
    exit 1
  }
  if ! git -C "$REPO" merge --ff-only --quiet refs/remotes/origin/main; then
    _refuse "local main cannot fast-forward to origin/main — it has diverged; resolve by hand, then re-run."
  fi

  # --- (b) must now equal origin/main -------------------------------------
  # Read by their fully-qualified refs, never a bare "main": a tag named
  # "main" resolves ahead of the branch of the same name in git's own
  # disambiguation order, and would silently change this comparison (and
  # the range computed from it in step (c)) to the tag's commit instead.
  TARGET_SHA="$(git -C "$REPO" rev-parse refs/heads/main)"
  ORIGIN_SHA="$(git -C "$REPO" rev-parse refs/remotes/origin/main)"
  if [ "$TARGET_SHA" != "$ORIGIN_SHA" ]; then
    _refuse "local main ($TARGET_SHA) still does not equal origin/main ($ORIGIN_SHA) — refusing to deploy."
  fi

  # --- (c) report the range, refuse on an alembic change, warn on a
  # launchd job this installer doesn't manage -----------------------------
  if DEPLOYED_SHA="$(_resolve_deployed_sha "$DEPLOYED_COMMIT_FILE" "$TARGET_SHA")"; then
    :
  else
    RC=$?
    if [ "$RC" -eq 2 ]; then
      _refuse "nothing has ever been deployed (no $DEPLOYED_COMMIT_FILE) — run bin/install-library by hand for this first install; library-install only manages a repeat deploy against a recorded baseline."
    fi
    exit 1
  fi
  say "deployed commit: $DEPLOYED_SHA"
  say "target commit:   $TARGET_SHA"

  if [ "$DEPLOYED_SHA" = "$TARGET_SHA" ]; then
    say "nothing new to deploy — already at the target commit."
  else
    say "merged PR titles ($DEPLOYED_SHA..$TARGET_SHA):"
    git -C "$REPO" log --first-parent --format='  %s' "$DEPLOYED_SHA..$TARGET_SHA" | _strip_controls

    ALEMBIC_CHANGES="$(git -C "$REPO" diff --name-only "$DEPLOYED_SHA..$TARGET_SHA" -- alembic/versions)"
    if [ -n "$ALEMBIC_CHANGES" ]; then
      say "this range changes alembic/versions — install-library will back up the vault and apply it:"
      printf '%s\n' "$ALEMBIC_CHANGES" | _strip_controls | sed 's/^/    /'
    fi

    PLIST_CHANGES="$(git -C "$REPO" diff --name-only "$DEPLOYED_SHA..$TARGET_SHA" -- launchd | grep -v '^launchd/com\.convivy\.library\.plist$' || true)"
    if [ -n "$PLIST_CHANGES" ]; then
      warn "this range changes a launchd job install-library does not manage:"
      printf '%s\n' "$PLIST_CHANGES" | _strip_controls | sed 's/^/    /' >&2
      warn "render it into ~/Library/LaunchAgents with bin/install-library --internal-render-plist launchd/<name>.plist > ~/Library/LaunchAgents/<name>.plist (a raw copy installs the unexpanded home placeholder), then bootstrap it by hand: launchctl bootstrap gui/\$(id -u) ~/Library/LaunchAgents/<name>.plist"
    fi
  fi

  # --- (d) deploy -----------------------------------------------------------
  # Not wrapped in `|| true` or captured into a variable: under `set -eu`, a
  # refusal here (an unknown vault revision, a `LIBRARY_AUTO_APPLY = False`
  # revision, a failed migration, or --no-migrate over a vault that's
  # behind) prints install-library's own message to stderr and exits this
  # script right here, with the same status, before step (e)'s verdict ever
  # runs.
  if [ "$NO_MIGRATE" -eq 1 ]; then
    say "running $INSTALL_LIBRARY_BIN --no-migrate"
    "$INSTALL_LIBRARY_BIN" --no-migrate
  else
    say "running $INSTALL_LIBRARY_BIN"
    "$INSTALL_LIBRARY_BIN"
  fi

  # --- (e) verdict -----------------------------------------------------------
  # install-library --status reads $DEPLOYED_COMMIT_FILE, which step (d)
  # just wrote synchronously — it cannot change again before a second
  # deploy, so it is read once rather than polled.
  STATUS_OUTPUT="$("$INSTALL_LIBRARY_BIN" --status 2>&1)" || true
  STATUS_SHA="$(printf '%s\n' "$STATUS_OUTPUT" | sed -n 's/^commit: //p' | head -n 1)"

  # /health, by contrast, reports what the RUNNING process has loaded, and
  # it self-restarts onto the new commit rather than being reloaded by this
  # script — a single read immediately after install-library returns can
  # only ever see the OLD commit or none at all, every time, which is
  # exactly how this reported "Deploy confirmed" on a deploy that left the
  # service down (library issue issue_01M584Q5SH8BQVGABSQWBPBV62). Poll
  # until it agrees or the deadline runs out.
  POLL_DEADLINE_S="$(_health_poll_deadline_seconds)"
  POLL_START_S="$(date +%s)"
  HEALTH_JSON="$(_fetch_health)"
  HEALTH_SHA="$(_health_field "$HEALTH_JSON" commit)"
  HEALTH_STAGED_SHA="$(_health_field "$HEALTH_JSON" staged_commit)"
  while [ "$HEALTH_SHA" != "$TARGET_SHA" ]; do
    ELAPSED_S=$(( $(date +%s) - POLL_START_S ))
    [ "$ELAPSED_S" -ge "$POLL_DEADLINE_S" ] && break
    sleep "$_HEALTH_POLL_INTERVAL_S"
    HEALTH_JSON="$(_fetch_health)"
    HEALTH_SHA="$(_health_field "$HEALTH_JSON" commit)"
    HEALTH_STAGED_SHA="$(_health_field "$HEALTH_JSON" staged_commit)"
  done

  if [ "$STATUS_SHA" = "$TARGET_SHA" ] && [ "$HEALTH_SHA" = "$TARGET_SHA" ]; then
    say "verdict: target $TARGET_SHA — install-library --status and /health both agree. Deploy confirmed."
    return 0
  fi

  warn "verdict: target $TARGET_SHA; install-library --status reports ${STATUS_SHA:-nothing}; /health reports commit=${HEALTH_SHA:-none} staged_commit=${HEALTH_STAGED_SHA:-none} after waiting up to ${POLL_DEADLINE_S}s — the code is installed but the service is not serving it."
  # Never run for real under a test redirect, even though launchctl print
  # is read-only: the no-agent-no-test rule at the top of this file covers
  # every real launchd call this script makes, not only the mutating ones.
  if [ -z "${LIBRARY_INSTALL_TEST_INSTALL_LIBRARY:-}" ] && command -v launchctl >/dev/null 2>&1; then
    LABEL="$(basename "$PLIST_TEMPLATE" .plist)"
    if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
      warn "launchctl print gui/$(id -u)/$LABEL finds the job."
    else
      warn "launchctl print gui/$(id -u)/$LABEL does not find the job — it may have been removed rather than merely restarting."
    fi
  fi
  exit 3
}

if [ -z "${LIBRARY_INSTALL_SOURCE_ONLY:-}" ]; then
  main "$@"
fi
# NOTHING MAY FOLLOW THIS BLOCK. Step (a) above replaces this very file via
# `git merge --ff-only` while it is running; /bin/sh reads a script file
# into memory before executing any of it, and git replaces a file by
# unlink+create rather than an in-place truncate, so the already-open,
# already-unlinked original inode keeps feeding the interpreter to the end —
# but only because this `if` is the last construct in the file. Anything
# appended below it would never run from the version just invoked, and a
# reader shouldn't trust that it would run on some later re-read either. Add
# new behavior inside main() or in a function above this line, never below
# it.
