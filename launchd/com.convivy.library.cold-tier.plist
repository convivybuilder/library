<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- A TEMPLATE, NOT A LOADABLE PLIST: every path under the installing
       user's home carries bin/install-library's home placeholder, and
       launchd does not expand it. Never copy this file raw. Render it
       through that script's internal render entry point; the comment
       above that entry point gives the exact command. -->
<dict>
  <key>Label</key>
  <string>com.convivy.library.cold-tier</string>
  <!-- DEPLOY-PINNED, same rule com.convivy.library.plist and
       com.convivy.library.ci-result-fetch.plist follow (platform/decisions/
       0059 rule 1): a timer invokes the mover from the deploy area, never
       the working checkout, because nobody is testing anything when
       launchd fires this unattended. cold_tier.py is exported into
       ~/.local/deploy/library by bin/install-library like every other
       tracked file, so it lands here automatically on the next install —
       this file only names the deploy-area path, it does not arrange for
       the script to be there.

       This is the VERSIONED TEMPLATE. It is not what launchd loads:
       bin/install-library copies it to ~/Library/LaunchAgents on install
       (rule 8), and THIS PR DOES NOT LOAD IT — deploy section 5's own
       step 9, loading it, is the operator's and the co's call, after
       steps 1-8 have run the migration, created the cold file, and proved
       a dry run against live data. -->
  <key>ProgramArguments</key>
  <array>
    <string>@@LIBRARY_HOME@@/.local/deploy/library/.venv/bin/python3</string>
    <string>@@LIBRARY_HOME@@/.local/deploy/library/cold_tier.py</string>
  </array>
  <!-- `cold_tier.py` opens `LIBRARY_DB` and `LIBRARY_COLD_DB` directly
       through `store.py`, unlike `ci_result_fetch.py`'s sibling job, which
       posts over HTTP and needs neither — so this plist carries the same
       four variables the service's own plist sets for the same reason
       (see that file's own comment on each): `LIBRARY_DB` and
       `LIBRARY_WRITES_ENABLED=1` together, never one without the other;
       `LIBRARY_VECTORS_DB`, which `vectors.py` resolves at import for its
       `HOT_WINDOW_DAYS` table even though this mover never opens the file
       it names; and `LIBRARY_COLD_DB`, this job's own reason for existing.
       The deployed values here MUST match the service's own plist — a
       divergence would move a signal cold in one database while the
       running service reads another. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@@LIBRARY_HOME@@</string>
    <key>LIBRARY_DB</key>
    <string>@@LIBRARY_HOME@@/.library/library.db</string>
    <key>LIBRARY_COLD_DB</key>
    <string>@@LIBRARY_HOME@@/.library/cold.db</string>
    <key>LIBRARY_VECTORS_DB</key>
    <string>@@LIBRARY_HOME@@/.library/vectors.db</string>
    <key>LIBRARY_WRITES_ENABLED</key>
    <string>1</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@@LIBRARY_HOME@@/.local/deploy/library</string>
  <!-- A sweep, not a server, the same shape ci-result-fetch takes: RunAtLoad
       picks up whatever the last run missed (a restart, a sleep, a prior
       failure) as soon as the job loads; StartInterval repeats it every 6
       hours after that. The retention windows this moves against are day-
       granularity (0, 30, 90 or 180 days), so sub-hour polling buys nothing
       a few hours a day wouldn't — unlike ci-result-fetch's 15-minute
       interval, which exists to keep a PR panel current. No KeepAlive — a
       run that exits (0 or 1) is expected to exit, unlike the request
       server this plist's cousin keeps alive. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <!-- ~/.library is the Library's own external state area, the same
       directory `LIBRARY_DB` and `LIBRARY_COLD_DB` above already live in —
       never the deploy area, which an atomic install swap replaces
       wholesale and would destroy a log living inside it. -->
  <key>StandardOutPath</key>
  <string>@@LIBRARY_HOME@@/.library/cold-tier.log</string>
  <key>StandardErrorPath</key>
  <string>@@LIBRARY_HOME@@/.library/cold-tier.log</string>
</dict>
</plist>
