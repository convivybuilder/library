<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- A TEMPLATE, NOT A LOADABLE PLIST: every path under the installing
       user's home carries bin/install-library's home placeholder, and
       launchd does not expand it. Never copy this file raw. Render it
       through that script's internal render entry point; the comment
       above that entry point gives the exact command. -->
<dict>
  <key>Label</key>
  <string>com.convivy.library.ci-result-fetch</string>
  <!-- DEPLOY-PINNED, same rule com.convivy.library.plist follows
       (platform/decisions/0059 rule 1): a timer invokes a job from the
       deploy area, never the working checkout, because nobody is testing
       anything when launchd fires this unattended. bin/ci_result_fetch.py
       is exported into ~/.local/deploy/library by bin/install-library like
       every other tracked file, so it lands here automatically on the next
       install — this file only names the deploy-area path, it does not
       arrange for the script to be there.

       This is the VERSIONED TEMPLATE. It is not what launchd loads:
       bin/install-library copies it to ~/Library/LaunchAgents on install
       (rule 8), and THIS PR DOES NOT LOAD IT — bootstrap is the operator's
       call, same as every other job change. -->
  <key>ProgramArguments</key>
  <array>
    <string>@@LIBRARY_HOME@@/.local/deploy/library/.venv/bin/python3</string>
    <string>@@LIBRARY_HOME@@/.local/deploy/library/bin/ci_result_fetch.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@@LIBRARY_HOME@@</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@@LIBRARY_HOME@@/.local/deploy/library</string>
  <!-- A poll, not a server: RunAtLoad picks up whatever the last run missed
       (a restart, a sleep, a prior failure) as soon as the job loads;
       StartInterval repeats it every 15 minutes after that. No KeepAlive —
       a run that exits (0 or 1) is expected to exit, unlike the request
       server this plist's sibling keeps alive. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <!-- ~/.library is the Library's own external state area — where
       ci_result_fetch.py itself reads/writes its cursor
       (ci-fetch-cursor.json) and its credential (ci-fetch-token) by
       absolute path, matching LIBRARY_DB and client-tokens.json on the
       sibling plist. Never the deploy area: an atomic install swap
       replaces ~/.local/deploy/library wholesale, which would destroy a
       cursor or a log living inside it. -->
  <key>StandardOutPath</key>
  <string>@@LIBRARY_HOME@@/.library/ci-fetch.log</string>
  <key>StandardErrorPath</key>
  <string>@@LIBRARY_HOME@@/.library/ci-fetch.log</string>
</dict>
</plist>
